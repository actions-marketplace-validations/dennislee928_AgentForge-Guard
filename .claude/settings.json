{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "claude-posttool-format"
            ],
            "command": "afg",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "claude-pretool"
            ],
            "command": "afg",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
